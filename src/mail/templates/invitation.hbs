<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Invitation</title>
  </head>

  <body
    style='margin:0;padding:0;background-color:#f4f6f9;font-family:Arial, sans-serif;'
  >
    <table
      width='100%'
      cellpadding='0'
      cellspacing='0'
      style='padding:40px 16px;'
    >
      <tr>
        <td align='center'>

          <table
            width='560'
            cellpadding='0'
            cellspacing='0'
            style='background:#ffffff;border-radius:12px;overflow:hidden;
                   border:1px solid #e5e7eb;box-shadow:0 6px 18px rgba(0,0,0,0.05);'
          >

            <!-- Top accent -->
            <tr>
              <td
                style='background:linear-gradient(90deg,#3b82f6,#2563eb);height:4px;'
              ></td>
            </tr>

            <!-- Header -->
            <tr>
              <td style='padding:28px 40px 0;'>
                <h2
                  style='margin:0;font-size:20px;color:#111827;font-weight:700;'
                >
                  {{appName}}
                </h2>
              </td>
            </tr>

            <!-- Body -->
            <tr>
              <td style='padding:28px 40px 0;'>
                <h1 style='margin:0 0 14px;font-size:24px;color:#111827;'>
                  You're invited to join
                </h1>

                <p
                  style='margin:0 0 18px;color:#4b5563;font-size:14px;line-height:1.7;'
                >
                  You’ve been invited to access
                  <strong style='color:#111827;'>{{appName}}</strong>, your
                  warehouse management platform. Click below to activate your
                  account.
                </p>

                <p style='margin:0 0 26px;color:#6b7280;font-size:13px;'>
                  This invitation link expires in
                  <strong style='color:#111827;'>5 minutes</strong>.
                </p>

                <!-- Button -->
                <table cellpadding='0' cellspacing='0'>
                  <tr>
                    <td>
                      <a
                        href='{{link}}'
                        style='display:inline-block;padding:12px 30px;
                               background:#2563eb;color:#ffffff;
                               font-size:14px;font-weight:600;
                               text-decoration:none;border-radius:6px;'
                      >
                        Accept Invitation
                      </a>
                    </td>
                  </tr>
                </table>

                <!-- Fallback -->
                <p style='margin:26px 0 8px;font-size:12px;color:#6b7280;'>
                  Or copy and paste this URL:
                </p>

                <p
                  style='font-size:12px;
                  margin-bottom:10px;
                          background:#f9fafb;
                          padding:12px 12px 12px 14px;
                          border-radius:6px;
                          color:#374151;
                          word-break:break-all;
                          border-left:4px solid #2563eb;'
                >
                  {{link}}
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                style='padding:28px 40px 34px;background:#f9fafb;
                         border-top:1px solid #e5e7eb;margin-top:28px;'
              >
                <p
                  style='margin:0;font-size:12px;color:#9ca3af;line-height:1.7;'
                >
                  If you did not request this invitation, you can safely ignore
                  this email.<br />
                  &copy;
                  {{appName}}. All rights reserved.
                </p>
              </td>
            </tr>

          </table>

        </td>
      </tr>
    </table>
  </body>
</html>