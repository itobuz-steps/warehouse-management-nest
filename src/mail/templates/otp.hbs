<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Your OTP Code</title>
  </head>

  <body
    style='margin:0;padding:0;background-color:#f4f6f9;font-family:Arial,sans-serif;'
  >
    <table
      width='100%'
      cellpadding='0'
      cellspacing='0'
      style='padding:48px 16px;'
    >
      <tr>
        <td align='center'>

          <table
            width='520'
            cellpadding='0'
            cellspacing='0'
            style='background:#ffffff;border-radius:12px;overflow:hidden;
                 border:1px solid #e5e7eb;box-shadow:0 6px 18px rgba(0,0,0,0.05);'
          >

            <!-- Top accent -->
            <tr>
              <td
                style='background:linear-gradient(90deg,#3b82f6,#2563eb);height:4px;'
              ></td>
            </tr>

            <!-- Header -->
            <tr>
              <td style='padding:28px 40px 0;'>
                <table width='100%'>
                  <tr>
                    <td>
                      <p
                        style='font-size:18px;font-weight:700;color:#1e3a8a;margin:0;'
                      >
                        {{appName}}
                      </p>
                    </td>
                    <td align='right'>
                      <span
                        style='background:#eff6ff;color:#1d4ed8;
                                 font-size:11px;font-weight:700;
                                 padding:6px 12px;border-radius:999px;
                                 border:1px solid #bfdbfe;'
                      >
                        Security Code
                      </span>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Title -->
            <tr>
              <td style='padding:26px 40px 0;'>
                <h1
                  style='font-size:22px;font-weight:700;color:#111827;margin:0 0 10px;'
                >
                  Verify your identity
                </h1>

                <p
                  style='font-size:14px;line-height:1.7;color:#4b5563;margin:0;'
                >
                  Use the one-time password below to complete your verification.
                  This code is confidential and should not be shared.
                </p>
              </td>
            </tr>

            <!-- OTP Box -->
            <tr>
              <td style='padding:26px 40px;'>
                <table width='100%'>
                  <tr>
                    <td
                      align='center'
                      style='background:#f9fafb;border:1px solid #e5e7eb;
                           border-radius:10px;padding:26px 20px;'
                    >

                      <p
                        style='font-size:11px;font-weight:700;
                               letter-spacing:0.12em;text-transform:uppercase;
                               color:#6b7280;margin:0 0 12px;'
                      >
                        One-Time Password
                      </p>

                      <p
                        style="font-family:'Courier New',monospace;
                               font-size:40px;font-weight:700;
                               color:#1e3a8a;letter-spacing:0.3em;
                               margin:0;line-height:1;"
                      >
                        {{otp}}
                      </p>

                      <p style='font-size:12px;color:#9ca3af;margin:14px 0 0;'>
                        Valid for
                        <strong style='color:#111827;'>10 minutes</strong>
                      </p>

                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Warning Box -->
            <tr>
              <td style='padding:0 40px 28px;'>
                <table width='100%'>
                  <tr>
                    <td
                      style='background:#f9fafb;border-left:4px solid #f59e0b;
                             border-radius:6px;padding:14px 16px;'
                    >
                      <p
                        style='font-size:13px;color:#374151;margin:0;line-height:1.6;'
                      >
                        <strong>Do not share this code.</strong>
                        <br />
                        {{appName}}
                        will never ask for your OTP via phone or email. If you
                        didn’t request this, please secure your account
                        immediately.
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td style='padding:24px 40px 34px;border-top:1px solid #e5e7eb;'>
                <p
                  style='font-size:12px;color:#9ca3af;line-height:1.7;margin:0;'
                >
                  This is an automated message from
                  {{appName}}. Please do not reply.<br />
                  &copy;
                  {{appName}}. All rights reserved.
                </p>
              </td>
            </tr>

          </table>

        </td>
      </tr>
    </table>
  </body>
</html>