<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Shipment Cancelled</title>
  </head>

  <body
    style='margin:0;padding:0;background-color:#f6f7fb;font-family:Arial,sans-serif;'
  >
    <table
      width='100%'
      cellpadding='0'
      cellspacing='0'
      style='padding:48px 16px;'
    >
      <tr>
        <td align='center'>

          <table
            width='560'
            cellpadding='0'
            cellspacing='0'
            style='background:#ffffff;border-radius:12px;overflow:hidden;
                 border:1px solid #e5e7eb;box-shadow:0 6px 18px rgba(0,0,0,0.05);'
          >

            <!-- Top accent -->
            <tr>
              <td
                style='background:linear-gradient(90deg,#ef4444,#dc2626);height:4px;'
              ></td>
            </tr>

            <!-- Header -->
            <tr>
              <td style='padding:28px 40px 0;'>
                <table width='100%'>
                  <tr>
                    <td>
                      <p
                        style='font-size:18px;font-weight:700;color:#111827;margin:0;'
                      >
                        {{appName}}
                      </p>
                    </td>
                    <td align='right'>
                      <span
                        style='background:#fef2f2;color:#b91c1c;
                                 font-size:11px;font-weight:700;
                                 padding:6px 12px;border-radius:999px;
                                 border:1px solid #fecaca;'
                      >
                        Cancelled
                      </span>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Title -->
            <tr>
              <td style='padding:26px 40px 0;'>
                <h1
                  style='font-size:22px;font-weight:700;color:#111827;margin:0 0 10px;'
                >
                  Shipment cancelled
                </h1>

                <p
                  style='font-size:14px;line-height:1.7;color:#4b5563;margin:0;'
                >
                  Hi
                  <strong style='color:#111827;'>{{customerName}}</strong>, your
                  shipment has been cancelled. You’ll find the relevant details
                  below. Please contact us if you need further assistance.
                </p>
              </td>
            </tr>

            <!-- Details Card -->
            <tr>
              <td style='padding:22px 40px 0;'>
                <table
                  width='100%'
                  cellpadding='0'
                  cellspacing='0'
                  style='background:#ffffff;border:1px solid #e5e7eb;
                       border-radius:10px;overflow:hidden;'
                >

                  <!-- Header -->
                  <tr>
                    <td
                      style='padding:14px 18px;background:#f9fafb;
                             border-bottom:1px solid #e5e7eb;'
                    >
                      <p
                        style='font-size:11px;font-weight:700;
                              letter-spacing:0.08em;text-transform:uppercase;
                              color:#6b7280;margin:0;'
                      >
                        Cancellation Details
                      </p>
                    </td>
                  </tr>

                  <!-- Content -->
                  <tr>
                    <td style='padding:0 18px;'>
                      <table
                        width='100%'
                        cellpadding='0'
                        cellspacing='0'
                        style='font-size:14px;'
                      >

                        <tr>
                          <td
                            style='padding:14px 0 10px;color:#6b7280;width:40%;
                                   border-bottom:1px solid #f1f5f9;'
                          >
                            Order ID
                          </td>
                          <td
                            style="padding:14px 0 10px;font-weight:600;
                                   font-family:'Courier New',monospace;
                                   color:#111827;border-bottom:1px solid #f1f5f9;"
                          >
                            {{orderId}}
                          </td>
                        </tr>

                        <tr>
                          <td
                            style='padding:10px 0;color:#6b7280;
                                   border-bottom:1px solid #f1f5f9;'
                          >
                            Status
                          </td>
                          <td
                            style='padding:10px 0;border-bottom:1px solid #f1f5f9;'
                          >
                            <span
                              style='background:#fef2f2;color:#dc2626;
                                       font-weight:600;padding:4px 10px;
                                       border-radius:6px;font-size:13px;'
                            >
                              {{shipmentStatus}}
                            </span>
                          </td>
                        </tr>

                        <tr>
                          <td style='padding:12px 0 16px;color:#6b7280;'>
                            Contact
                          </td>
                          <td style='padding:12px 0 16px;'>
                            <a
                              href='mailto:{{performedByEmail}}'
                              style='color:#2563eb;text-decoration:none;font-weight:500;'
                            >
                              {{performedByEmail}}
                            </a>
                          </td>
                        </tr>

                      </table>
                    </td>
                  </tr>

                </table>
              </td>
            </tr>

            <!-- Info Box -->
            <tr>
              <td style='padding:24px 40px 20px;'>
                <table width='100%'>
                  <tr>
                    <td
                      style='background:#f9fafb;border-left:4px solid #dc2626;
                             border-radius:6px;padding:14px 16px;'
                    >
                      <p
                        style='font-size:13px;color:#374151;margin:0;line-height:1.6;'
                      >
                        A cancellation invoice is attached to this email. Please
                        keep it for your records. For refund or order-related
                        queries, contact the email above.
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td style='padding:30px 40px 36px;border-top:1px solid #e5e7eb;'>
                <p
                  style='font-size:12px;color:#9ca3af;line-height:1.7;margin:0;'
                >
                  This is an automated notification from
                  {{appName}}.<br />
                  &copy;
                  {{appName}}. All rights reserved.
                </p>
              </td>
            </tr>

          </table>

        </td>
      </tr>
    </table>
  </body>
</html>